Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Odometry1/Shape1
        - /Odometry Path1/Topic1
        - /Odometry Path1/Shape1
        - /MarkerArray1
        - /MarkerArray1/Status1
        - /Cave Geometry1
